{
  "info": {
    "name": "SIGIP API",
    "description": "Colección para probar SIGIP a través del API Gateway. Ejecuta las carpetas en orden: cada request guarda los ids que usa el siguiente. Cambia la variable gateway a la URL de la nube para probar el despliegue.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{gateway}}/auth-service/api/v1/auth/login",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "auth-service",
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomusuario\": \"admin\",\n  \"password\": \"{{admin_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 2xx', () => pm.response.to.be.success);",
                  "pm.collectionVariables.set('token_admin', pm.response.json().token);",
                  "pm.collectionVariables.set('sufijo', Date.now().toString().slice(-6)); // nombres únicos por ejecución"
                ]
              }
            }
          ]
        },
        {
