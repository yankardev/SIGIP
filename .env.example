# Copia este archivo como .env y cambia los valores. Nunca subas el .env al repositorio.

# Clave HMAC compartida por todos los servicios (Base64, mínimo 32 bytes).
# Genera una con:  openssl rand -base64 48
JWT_SECRET=cambia-esta-clave-por-una-generada-con-openssl-rand-base64-48

# Base de datos MySQL (docker-compose)
MYSQL_ROOT_PASSWORD=sigip_root_2025

# RabbitMQ
RABBITMQ_USER=sigip
RABBITMQ_PASSWORD=sigip_rabbit_2025

# Administrador inicial que crea auth-service al arrancar
SIGIP_ADMIN_USERNAME=admin
SIGIP_ADMIN_EMAIL=admin@sigip.local
SIGIP_ADMIN_PASSWORD=Admin12345

# Orígenes permitidos por el gateway (frontend)
CORS_ORIGINS=http://localhost:4200
